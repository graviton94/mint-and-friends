rules_version = '2';

// 게임 저장: users/{uid} 문서 하나. 본인만 읽고 쓸 수 있다.
// 친구(소셜): profiles · codes · users/{uid}/friends · inbox · notices. 선물은 Cloud Function(sendGift)만 만든다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'level', 'area', 'progress', 'updatedAt', 'schema'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000
        && request.resource.data.level is int
        && request.resource.data.updatedAt == request.time;
      // 삭제는 Cloud Function(deleteAccount)이 관리자 권한으로만 한다
      allow delete: if false;

      // 내가 추가한 친구 (팔로우 방식, 상대 동의 불필요). lastGiftSentDay 는 sendGift 가 쓴다.
      match /friends/{friendUid} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && friendUid != uid
          && request.resource.data.keys().hasOnly(['addedAt'])
          && request.resource.data.addedAt == request.time;
        allow update: if false;
      }
    }

    // 공개 프로필: 로그인한 누구나 읽고, 본인만 쓴다. 친구 코드는 본인이 예약한 것이어야 한다.
    // 새 앱은 합치기(merge)로 쓰고, 예전 앱(1.0.6 까지)은 문서 전체를 덮어쓴다 (invitedTs · invitedDays 가 빠진다).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'code', 'level', 'area', 'placed', 'friends', 'avatar', 'days', 'invitedBy', 'invitedAt', 'invitedTs', 'invitedDays', 'score', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level < 100000
        && request.resource.data.area is int
        && request.resource.data.area >= 0 && request.resource.data.area < 100000
        && request.resource.data.placed is list
        && request.resource.data.placed.size() <= 8
        && request.resource.data.friends is list
        && request.resource.data.friends.size() <= 16
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 24
        // 초대 (D-045): 플레이한 날 수 · 나를 초대한 사람 · 그때. 초대한 사람은 한 번 정하면 바꿀 수 없다.
        && (!('days' in request.resource.data) || (request.resource.data.days is int && request.resource.data.days >= 0))
        && (!('invitedBy' in request.resource.data) || (request.resource.data.invitedBy is string
              && request.resource.data.invitedBy.size() <= 128
              && request.resource.data.invitedBy != uid))
        && (!('invitedAt' in request.resource.data) || request.resource.data.invitedAt is int)
        // invitedAt 은 기기 시각이라 초대 보상 판단에 쓰지 않는다 (예전 앱 호환으로만 받는다).
        // invitedTs: 초대를 처음 적은 서버 시각. 새로 적을 때는 반드시 지금(request.time), 그 뒤로는 그대로.
        // 예전 앱이 덮어써서 빠지는 것은 허용 (다시 적으면 그때 시각이라 기다림이 길어질 뿐 앞당길 수 없다).
        && (!('invitedTs' in request.resource.data)
              || (request.resource.data.get('invitedBy', '') != ''
                  && (request.resource.data.invitedTs == request.time
                      || (resource != null
                          && request.resource.data.invitedTs == resource.data.get('invitedTs', null)))))
        // invitedDays: invitedTs 를 적을 때의 플레이 날 수. 그때만 바꿀 수 있다.
        && (!('invitedDays' in request.resource.data)
              || (request.resource.data.invitedDays is int && request.resource.data.invitedDays >= 0
                  && (request.resource.data.get('invitedTs', null) == request.time
                      || (resource != null
                          && request.resource.data.invitedDays == resource.data.get('invitedDays', -1)))))
        && (!('score' in request.resource.data) || (request.resource.data.score is int
              && request.resource.data.score >= 0 && request.resource.data.score <= 10000))
        && (resource == null || !('invitedBy' in resource.data) || resource.data.invitedBy == ''
              || request.resource.data.get('invitedBy', '') == resource.data.invitedBy)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 친구 코드 → uid. 만들기만 (이미 있는 코드는 덮어쓸 수 없다).
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && resource == null
        && code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // 받은 선물함: 본인만 읽고 지운다. 만드는 것은 sendGift 함수(관리자 권한)만.
    match /inbox/{uid}/items/{itemId} {
      allow read, delete: if isMe(uid);
      allow create, update: if false;
    }

    // 신고: 로그인한 사용자가 남기기만 한다 (읽기 · 고치기 · 지우기는 운영자가 콘솔에서).
    // 게임 안 '문제 알리기' (사용자가 쓴 글 + 진단). 쓰기만, 읽기는 운영 도구(서비스 계정)만.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'text', 'diag', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.diag is string
        && request.resource.data.diag.size() <= 2000
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'target', 'name', 'code', 'reason', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 64
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 16
        && request.resource.data.reason in ['name', 'harass', 'other']
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // 결제 기록 (D-066): 앱이 지급할 때 남긴다 (환불 확인용). 만들기만, 읽기 · 고치기는 운영 도구만.
    match /purchases/{orderId} {
      allow create: if signedIn()
        && resource == null
        && request.resource.data.keys().hasOnly(['uid', 'product', 'gems', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.product is string
        && request.resource.data.product.size() <= 64
        && request.resource.data.gems is int
        && request.resource.data.gems >= 0 && request.resource.data.gems <= 1000000
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // 환불 회수 표시 (D-066): tool/refunds.py 가 만들고, 본인이 읽고 반영한 뒤 지운다.
    match /revocations/{uid}/items/{orderId} {
      allow read, delete: if isMe(uid);
      allow create, update: if false;
    }

    // 운영 공지: 읽기만 (쓰기는 tool/post_notice.py, 관리자 권한).
    match /notices/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // gifts/*, giftCounts/* 등 나머지는 함수 전용 (아래 기본 거부).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

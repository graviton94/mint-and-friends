rules_version = '2';

// 게임 저장: users/{uid} 문서 하나. 본인만 읽고 쓸 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'level', 'area', 'progress', 'updatedAt', 'schema'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000
        && request.resource.data.level is int
        && request.resource.data.updatedAt == request.time;
      // 삭제는 Cloud Function(deleteAccount)이 관리자 권한으로만 한다
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
